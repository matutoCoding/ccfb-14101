{
  "name": "barcode-camera-sim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "读码相机成像仿真系统 - 快递分拣交叉带读码方案选型/布局/成像/读码统计",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
