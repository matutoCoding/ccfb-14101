    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@zxing/library": "^0.21.3",
    "idb": "^8.0.0",
    "preact": "^10.24.3"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.9.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
